# Turonomics — server configuration
#
# Copy to .env for local work; paste into Render's environment settings for
# deploys. .env is gitignored — never commit real values.
#
# Legend:
#   [you]   something you obtain and give me
#   [me]    I generate it; listed so you know what it is
#   [render] Render fills it in automatically
#   [opt]   has a working default, override only if you want to

# ─────────────────────────────────────────────────────────────────────────────
# Core
# ─────────────────────────────────────────────────────────────────────────────
ENVIRONMENT=development                      # development | production   [opt]
LOG_LEVEL=info                                                          # [opt]
DATABASE_URL=postgresql://localhost/turonomics                      # [render]
APP_BASE_URL=http://localhost:8000           # public URL; OAuth redirects,
                                             # webhook URLs and push all
                                             # derive from this              [you]
SECRET_KEY=                                  # session signing key           [me]

# Street cleaning is local wall-clock time and DST matters, so this is explicit
# rather than inherited from the process timezone.
FLEET_TIMEZONE=America/New_York                                         # [opt]

# ─────────────────────────────────────────────────────────────────────────────
# Auth — Google sign-in (D8)
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=                                                 # [you]
GOOGLE_OAUTH_CLIENT_SECRET=                                             # [you]

# Allowlist. Without this, anyone with a Google account can sign in to your
# fleet. Comma-separated; add your helper's address when they start.
ALLOWED_SIGNIN_EMAILS=jambola441@gmail.com                              # [you]

# ─────────────────────────────────────────────────────────────────────────────
# Bouncie — telemetry (D9 step 2, first thing I need)
# ─────────────────────────────────────────────────────────────────────────────
BOUNCIE_CLIENT_ID=                                                      # [you]
BOUNCIE_CLIENT_SECRET=                                                  # [you]
# Must match what's registered in the Bouncie dev portal BYTE FOR BYTE --
# trailing slash and http/https both count, and a mismatch fails the token
# exchange with an unhelpful error. Nothing needs to listen on this address:
# Bouncie redirects your browser here with ?code=... and you copy the code out
# of the URL bar. Matches APP_BASE_URL so a local server can handle it later.
BOUNCIE_REDIRECT_URI=http://localhost:8000/auth/bouncie/callback        # [you]

# The ?code=... value from that redirect. Exchanged once for tokens, which then
# live in the database and refresh themselves. If it has expired, just redo the
# authorize URL in a browser -- it takes about 30 seconds and needs no deploy.
BOUNCIE_AUTH_CODE=                                                      # [you]

# Shared secret embedded in the webhook path, so an unauthenticated POST to a
# guessed URL can't inject fake vehicle events. I'm not yet certain whether
# Bouncie signs its webhooks; this works either way, and I'll add signature
# verification on top if they do.
BOUNCIE_WEBHOOK_TOKEN=                                                   # [me]

# ─────────────────────────────────────────────────────────────────────────────
# Browser extension → API (D2)
# ─────────────────────────────────────────────────────────────────────────────
# Bootstrap token the extension presents. The app issues rotatable tokens once
# it's running; this one exists so the extension can talk to a fresh deploy.
EXTENSION_BOOTSTRAP_TOKEN=                                               # [me]

# ─────────────────────────────────────────────────────────────────────────────
# Alerts — web push (D6)
# ─────────────────────────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=                                                        # [me]
VAPID_PRIVATE_KEY=                                                       # [me]
VAPID_SUBJECT=mailto:jambola441@gmail.com                               # [opt]

# Minutes before a must-move deadline to fire each alert, soonest last.
ASP_ALERT_LEAD_MINUTES=720,120,60,15                                    # [opt]

# If no push receipt lands within this window, the app surfaces "alerts may not
# be reaching you" rather than staying quiet. This is the iPhone heartbeat.
PUSH_HEARTBEAT_STALE_HOURS=26                                           # [opt]

# ─────────────────────────────────────────────────────────────────────────────
# Alerts — SMS fallback (D6: built, off by default)
# ─────────────────────────────────────────────────────────────────────────────
ALERTS_SMS_ENABLED=false                     # flip to true if push proves flaky
TWILIO_ACCOUNT_SID=                                                     # [you]
TWILIO_AUTH_TOKEN=                                                      # [you]
TWILIO_FROM_NUMBER=                                                     # [you]
ALERT_SMS_TO=                                # your mobile, E.164 (+1718…)  [you]

# ─────────────────────────────────────────────────────────────────────────────
# NYC parking data (D3) — no credential required
# ─────────────────────────────────────────────────────────────────────────────
# An app token only raises Socrata rate limits; the dataset is public.
NYC_OPEN_DATA_APP_TOKEN=                                          # [you] [opt]
NYC_SIGNS_DATASET_ID=nfid-uabd                                          # [opt]
NYC_ASP_CALENDAR_ICS_URL=                    # DOT suspension calendar;
                                             # defaults to the current year  [opt]

# ─────────────────────────────────────────────────────────────────────────────
# Turo email ingestion (D2) — not needed until step 5
# ─────────────────────────────────────────────────────────────────────────────
GMAIL_INGEST_ENABLED=false
GMAIL_LABEL=Turo                             # label to watch; keeps the app out
                                             # of the rest of your mail      [opt]
GMAIL_POLL_INTERVAL_SECONDS=60               # polling to start; Pub/Sub push is
                                             # an upgrade, not a requirement [opt]

# ─────────────────────────────────────────────────────────────────────────────
# Photo storage (D8) — not needed until step 5
# ─────────────────────────────────────────────────────────────────────────────
# Any S3-compatible bucket. Cloudflare R2 is my default suggestion (no egress
# fees), but Backblaze B2 or plain S3 work identically.
S3_ENDPOINT_URL=                                                        # [you]
S3_BUCKET=                                                              # [you]
S3_ACCESS_KEY_ID=                                                       # [you]
S3_SECRET_ACCESS_KEY=                                                   # [you]
S3_REGION=auto                                                          # [opt]
