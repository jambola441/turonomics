# Turonomics — server configuration
#
# Copy to .env for local work; paste into Render's environment settings for
# deploys. .env is gitignored — never commit real values.
#
# Legend:
#   [you]   something you obtain and give me
#   [me]    I generate it; listed so you know what it is
#   [render] Render fills it in automatically
#   [opt]   has a working default, override only if you want to

# ─────────────────────────────────────────────────────────────────────────────
# Core
# ─────────────────────────────────────────────────────────────────────────────
ENVIRONMENT=development                      # development | production   [opt]
LOG_LEVEL=info                                                          # [opt]
# Supabase. Use the CONNECTION POOLER string, not the direct one: Supabase's
# direct connection is IPv6-only unless you buy the IPv4 add-on, and most hosts
# have no IPv6 egress. The pooler host looks like
#   postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Port 5432 on that host is session mode, which is what Alembic migrations
# need; 6543 is transaction mode and does not support prepared statements.
DATABASE_URL=postgresql://localhost/turonomics                          # [you]
APP_BASE_URL=http://localhost:8000           # public URL; OAuth redirects,
                                             # webhook URLs and push all
                                             # derive from this              [you]
SECRET_KEY=                                  # session signing key           [me]

# Street cleaning is local wall-clock time and DST matters, so this is explicit
# rather than inherited from the process timezone.
FLEET_TIMEZONE=America/New_York                                         # [opt]

# ─────────────────────────────────────────────────────────────────────────────
# Auth — Google sign-in (D8)
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=                                                 # [you]
GOOGLE_OAUTH_CLIENT_SECRET=                                             # [you]

# Allowlist. Without this, anyone with a Google account can sign in to your
# fleet. Comma-separated; add your helper's address when they start.
ALLOWED_SIGNIN_EMAILS=jambola441@gmail.com                              # [you]

# ─────────────────────────────────────────────────────────────────────────────
# Bouncie — telemetry (D9 step 2, first thing I need)
# ─────────────────────────────────────────────────────────────────────────────
BOUNCIE_CLIENT_ID=                                                      # [you]
BOUNCIE_CLIENT_SECRET=                                                  # [you]
# Must match what's registered in the Bouncie dev portal BYTE FOR BYTE --
# trailing slash and http/https both count, and a mismatch fails the token
# exchange with an unhelpful error. Nothing needs to listen on this address:
# Bouncie redirects your browser here with ?code=... and you copy the code out
# of the URL bar. Matches APP_BASE_URL so a local server can handle it later.
BOUNCIE_REDIRECT_URI=http://localhost:8000/auth/bouncie/callback        # [you]

# The ?code=... value from that redirect. Exchanged once for tokens, which then
# live in the database and refresh themselves. If it has expired, just redo the
# authorize URL in a browser -- it takes about 30 seconds and needs no deploy.
BOUNCIE_AUTH_CODE=                                                      # [you]

# Shared secret embedded in the webhook path, so an unauthenticated POST to a
# guessed URL can't inject fake vehicle events. I'm not yet certain whether
# Bouncie signs its webhooks; this works either way, and I'll add signature
# verification on top if they do.
BOUNCIE_WEBHOOK_TOKEN=                                                   # [me]

# ─────────────────────────────────────────────────────────────────────────────
# Browser extension → API (D2)
# ─────────────────────────────────────────────────────────────────────────────
# Bootstrap token the extension presents. The app issues rotatable tokens once
# it's running; this one exists so the extension can talk to a fresh deploy.
EXTENSION_BOOTSTRAP_TOKEN=                                               # [me]

# ─────────────────────────────────────────────────────────────────────────────
# Alerts — web push (D6)
# ─────────────────────────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=                                                        # [me]
VAPID_PRIVATE_KEY=                                                       # [me]
VAPID_SUBJECT=mailto:jambola441@gmail.com                               # [opt]

# Minutes before a must-move deadline to fire each alert, soonest last.
ASP_ALERT_LEAD_MINUTES=720,120,60,15                                    # [opt]

# If no push receipt lands within this window, the app surfaces "alerts may not
# be reaching you" rather than staying quiet. This is the iPhone heartbeat.
PUSH_HEARTBEAT_STALE_HOURS=26                                           # [opt]

# ─────────────────────────────────────────────────────────────────────────────
# Alerts — SMS fallback (D6: built, off by default)
# ─────────────────────────────────────────────────────────────────────────────
ALERTS_SMS_ENABLED=false                     # flip to true if push proves flaky
TWILIO_ACCOUNT_SID=                                                     # [you]
TWILIO_AUTH_TOKEN=                                                      # [you]
TWILIO_FROM_NUMBER=                                                     # [you]
ALERT_SMS_TO=                                # your mobile, E.164 (+1718…)  [you]

# ─────────────────────────────────────────────────────────────────────────────
# NYC parking data (D3) — no credential required
# ─────────────────────────────────────────────────────────────────────────────
# An app token only raises Socrata rate limits; the dataset is public.
NYC_OPEN_DATA_APP_TOKEN=                                          # [you] [opt]
NYC_SIGNS_DATASET_ID=nfid-uabd                                          # [opt]
NYC_ASP_CALENDAR_ICS_URL=                    # DOT suspension calendar;
                                             # defaults to the current year  [opt]

# ─────────────────────────────────────────────────────────────────────────────
# Turo email ingestion (D2) — not needed until step 5
# ─────────────────────────────────────────────────────────────────────────────
GMAIL_INGEST_ENABLED=false
GMAIL_LABEL=Turo                             # label to watch; keeps the app out
                                             # of the rest of your mail      [opt]
GMAIL_POLL_INTERVAL_SECONDS=60               # polling to start; Pub/Sub push is
                                             # an upgrade, not a requirement [opt]

# ─────────────────────────────────────────────────────────────────────────────
# Photo storage (D8) — not needed until step 5
# ─────────────────────────────────────────────────────────────────────────────
# Any S3-compatible bucket. Cloudflare R2 is my default suggestion (no egress
# fees), but Backblaze B2 or plain S3 work identically.
S3_ENDPOINT_URL=                                                        # [you]
S3_BUCKET=                                                              # [you]
S3_ACCESS_KEY_ID=                                                       # [you]
S3_SECRET_ACCESS_KEY=                                                   # [you]
S3_REGION=auto                                                          # [opt]

# ─────────────────────────────────────────────────────────────────────────────
# Cross-origin access (the UI is a separate static site)
# ─────────────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API. Named rather than "*",
# because this API holds fleet positions and trip history and a wildcard would
# let any page in any tab read them.
CORS_ALLOW_ORIGINS=https://turonomics-site.onrender.com                 # [opt]

# ─────────────────────────────────────────────────────────────────────────────
# First-run fleet setup
# ─────────────────────────────────────────────────────────────────────────────
# The database only accepts connections from inside Render, so the alternative
# to this is shelling into the service to run the CLI by hand. Safe to leave on
# permanently: vehicles are only created for devices not already registered,
# and a plate is only written when the vehicle has none — so a correction made
# in the app is not reverted by the next deploy. A failure here logs and
# continues rather than stopping the service.
BOOTSTRAP_FLEET=                             # set to true to enable          [you]

# Bouncie does not know licence plates, and toll matching joins on them.
# nickname=PLATE, comma separated. Normalised like any other plate, so dashes
# and spaces are fine.
BOOTSTRAP_PLATES=                            # e.g. Jimmy=LEH9892,Jolene=LWH4685

# Street-cleaning rules. Loads the NYC sign dataset for the fleet's zip on
# boot, but only when the table is empty — the fetch is a few thousand rows and
# redoing it on every deploy would add ~6s to each restart for no change. Set
# to `force` instead of `true` to reload over what is there, which is how to
# pick up the city's own monthly refresh.
BOOTSTRAP_SIGNS=                             # true | force                   [you]

# State-plane bounding box (EPSG:2263 feet) as x0,y0,x1,y1. Defaults to 11238.
# Widen this when the fleet parks outside Prospect Heights.
BOOTSTRAP_SIGNS_BBOX=                        # e.g. 991558,180860,997338,190790

# ─────────────────────────────────────────────────────────────────────────────
# Staying current
# ─────────────────────────────────────────────────────────────────────────────
# How often the API pulls fresh state from Bouncie. Defaults to 10 minutes and
# is on without being set: an app whose job is to warn you before a car is
# ticketed should not need a flag flipped before it starts watching. Set to 0
# to switch the loop off.
SYNC_INTERVAL_MINUTES=                       # default 10, 0 disables         [opt]

# Shared secret for POST /api/sync, so something outside the process can drive
# a poll. Needed because the in-process loop stops when the process does, and a
# free-tier service spins down after 15 minutes of no traffic — which is most
# of the night, exactly when a car is sitting on a street swept at 8:30am.
# With no token set the endpoint reports itself unavailable rather than running
# unauthenticated: it spends the Bouncie rate limit the whole fleet depends on.
SYNC_TOKEN=                                  # any long random string         [you]

# ─────────────────────────────────────────────────────────────────────────────
# Gmail (Turo trip ingestion)
# ─────────────────────────────────────────────────────────────────────────────
# Turo has had no public API since April 2023, so its notification emails are
# the only ingress that works without a browser open.
#
# GCP setup: enable the Gmail API, create an OAuth client of type *Web
# application*, and register this exact redirect URI:
#     https://turonomics.onrender.com/api/gmail/callback
# Scope is gmail.readonly. Publish the consent screen — while it is in Testing,
# Google expires the grant after 7 days and mail silently stops arriving.
#
# Nobody handles a token: visit /api/gmail/connect, approve, and the server
# keeps the grant. /api/gmail/status says whether it is still good.
GOOGLE_CLIENT_ID=                                                         # [you]
GOOGLE_CLIENT_SECRET=                                                     # [you]

# Which mailbox may be connected. The callback is reachable by anyone until
# D8's sign-in exists, so without this a stranger who found the URL could
# attach their own mailbox over yours. Set it.
GMAIL_ADDRESS=                               # e.g. you@gmail.com         [you]

# Only if the callback lives somewhere other than the Render URL above.
GMAIL_REDIRECT_URI=                                                       # [opt]
