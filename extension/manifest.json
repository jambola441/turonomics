{
  "manifest_version": 3,
  "name": "Turonomics",
  "version": "1.2.0",
  "description": "Export Turo host trip history, read what Turo's pages fetch, and send an E-ZPass statement to Turonomics",
  "permissions": [
    "downloads",
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://turo.com/*",
    "https://*.e-zpassny.com/*",
    "https://turonomics.onrender.com/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Turonomics"
  },
  "content_scripts": [
    {
      "matches": [
        "https://turo.com/*"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
