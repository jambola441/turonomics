{
  "manifest_version": 3,
  "name": "Turonomics",
  "version": "1.0.0",
  "description": "Export Turo host trip history (last 90 days) as CSV",
  "permissions": ["downloads", "scripting", "tabs"],
  "host_permissions": ["https://turo.com/*"],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Turonomics"
  },
  "content_scripts": [
    {
      "matches": ["https://turo.com/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ]
}
